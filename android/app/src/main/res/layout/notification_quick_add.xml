<?xml version="1.0" encoding="utf-8"?>
<!-- The quick-add bar's buttons (QuickBar.java). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/quick_expense"
        style="@style/QuickBarButton"
        android:contentDescription="Add expense"
        android:text="💸" />

    <TextView
        android:id="@+id/quick_income"
        style="@style/QuickBarButton"
        android:contentDescription="Add income"
        android:text="💰" />

    <TextView
        android:id="@+id/quick_transfer"
        style="@style/QuickBarButton"
        android:contentDescription="Add transfer"
        android:text="🔁" />

    <TextView
        android:id="@+id/quick_summary"
        style="@style/QuickBarButton"
        android:contentDescription="See summary"
        android:text="📊" />
</LinearLayout>
