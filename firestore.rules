rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function optString(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // Each user can read and delete only their own budget data, and write only documents
    // shaped the way the app and the watch write them, so a modified client can't fill the
    // database with junk. Writes the app doesn't make (other collections, odd ids) are refused.
    match /users/{uid}/{document=**} {
      allow read, delete: if isOwner(uid);
    }

    // settings/main: the whole settings object (src/data/types.ts Settings).
    match /users/{uid}/settings/{doc} {
      allow create, update: if isOwner(uid) && doc == 'main'
        && request.resource.data.keys().size() <= 40
        && request.resource.data.currency is string
        && request.resource.data.currency.size() <= 10;
    }

    // plans/YYYY-MM (MonthPlan).
    match /users/{uid}/plans/{month} {
      allow create, update: if isOwner(uid)
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['planned', 'startingBalance', 'updatedAt'])
        && request.resource.data.planned is map
        && (!('startingBalance' in request.resource.data) || request.resource.data.startingBalance is number);
    }

    // transactions/{id}: an entry, or the `deleted` marker a delete leaves (firestoreBackend.ts).
    match /users/{uid}/transactions/{id} {
      function isEntry(d) {
        return d.keys().hasOnly(['kind', 'date', 'month', 'amount', 'description', 'category', 'account', 'toAccount', 'debt', 'time', 'notSpending', 'updatedAt'])
          && d.kind in ['expense', 'income', 'transfer', 'repay', 'borrow', 'adjust']
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.month is string && d.month.matches('^[0-9]{4}-[0-9]{2}$')
          && d.amount is number && d.amount > -1000000000000 && d.amount < 1000000000000
          && optString(d, 'description', 2000)
          && optString(d, 'category', 200)
          && optString(d, 'account', 200)
          && optString(d, 'toAccount', 200)
          && optString(d, 'debt', 200)
          && optString(d, 'time', 5)
          && (!('notSpending' in d) || d.notSpending is bool);
      }
      function isDeletedMarker(d) {
        return d.keys().hasOnly(['deleted', 'updatedAt']) && d.deleted == true;
      }
      allow create, update: if isOwner(uid) && id.size() <= 200
        && (isEntry(request.resource.data) || isDeletedMarker(request.resource.data))
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    // Feedback from Settings › Feedback (src/data/feedback.ts). Signed-in users can only
    // add one; nobody can read, change or delete it from the app. The developer reads it
    // in the Firebase console, and scripts/feedback-mailer emails it to them.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'message', 'replyTo', 'platform', 'build', 'emailed', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'kind', 'message', 'platform', 'build', 'emailed', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['idea', 'bug']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && (!('replyTo' in request.resource.data) || request.resource.data.replyTo == request.auth.token.email)
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 20
        && request.resource.data.build is int
        && request.resource.data.emailed == false
        && request.resource.data.createdAt == request.time;
    }
  }
}
